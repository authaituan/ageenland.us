{
  "name": "agreenland_clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/cf/db-setup.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply greenland-db --remote && wrangler deploy",
    "db:setup": "node scripts/cf/db-setup.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply greenland-db --remote",
    "db:backup": "node scripts/cf/db-backup.mjs",
    "db:pull": "node scripts/cf/db-pull.mjs",
    "admin:create": "node scripts/cf/admin-create.mjs",
    "admin:check": "node scripts/cf/admin-check.mjs",
    "content:reset": "node scripts/cf/content-reset.mjs",
    "cf:export-sqlite": "node scripts/cf/export-sqlite.mjs",
    "cf:import": "node scripts/cf/import.mjs",
    "lint": "oxlint",
    "test:e2e": "npm run build && playwright test -c tests/e2e",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0",
    "wrangler": "^4.142.0"
  }
}
